+/* QEMU host keyboard: USB HID keyboard usages, separate from side buttons. */
+class SweetHIDKeyboard : public IOHIDEventService {
+    OSDeclareDefaultStructors(SweetHIDKeyboard);
+public:
+    bool start(IOService *provider) APPLE_KEXT_OVERRIDE {
+        if (!IOHIDEventService::start(provider)) { return false; }
+        setProperty("Transport", "Virtual");
+        setProperty("Product", "QEMU PC Keyboard");
+        registerService();
+        IOLog("SWEET PC: keyboard registered (USB HID usages)\n");
+        return true;
+    }
+    void key(UInt32 usage, bool down) {
+        if (usage < 4 || usage > 231 || held[usage] == down) { return; }
+        held[usage] = down;
+        IOHIDEvent *event = IOHIDEvent::keyboardEvent(mach_absolute_time(), kHIDPage_KeyboardOrKeypad, usage, down);
+        if (event) { dispatchEvent(event); event->release(); }
+    }
+    void releaseKeys() { for (UInt32 i = 4; i <= 231; i++) { if (held[i]) { key(i, false); } } }
+protected:
+    UInt32 getPrimaryUsagePage() APPLE_KEXT_OVERRIDE { return kHIDPage_GenericDesktop; }
+    UInt32 getPrimaryUsage() APPLE_KEXT_OVERRIDE { return kHIDUsage_GD_Keyboard; }
+private:
+    bool held[256] = {};
+};
+OSDefineMetaClassAndStructors(SweetHIDKeyboard, IOHIDEventService);
+static SweetHIDKeyboard *gSweetKeyboard;
+extern "C" int sweet_pc_keyboard_supported(void) { return 1; }
+
