+/* Host publishes a complete 32-byte record before advancing producer.
+ * Guest acknowledges only after dispatch, so release edges cannot be lost.
+ * Header: magic/version/producer/consumer/events/last-kind/heartbeat/reserved.
+ * Ring at +64: seq, kind(1 touch/2 key), finger-or-key, down, x, y, reserved*2.
+ */
+void
+SweetHIDTouch::pcInputFired(OSObject *owner, IOTimerEventSource *sender)
+{
+	SweetHIDTouch *self = (SweetHIDTouch *)owner;
+	volatile uint32_t *page = self->fPCInput;
+	uint32_t head = page[2], tail = page[3];
+	__asm__ volatile("dmb sy" ::: "memory");
+	if ((uint32_t)(head - tail) > 64) {
+		/* Invalid producer state: reset all contacts instead of leaving a drag held. */
+		for (int i = 0; i < 10; i++) { self->touch(i, false, 0, 0); }
+		for (int i = 0; i < 4; i++) { sweet_hid_key(i, 0); }
+		tail = head;
+	}
+	for (unsigned int count = 0; tail != head && count < 64; count++) {
+		volatile uint32_t *event = page + 16 + (tail & 63) * 8;
+		if (event[0] != tail + 1) { break; }
+		uint32_t kind = event[1], code = event[2], down = event[3];
+		if (kind == 1 && code < 10 && down <= 1 && event[4] < 1080 && event[5] < 2400) {
+			self->touch((int)code, down != 0, (int)event[4], (int)event[5]);
+		} else if (kind == 2 && code < 4 && down <= 1) {
+			sweet_hid_key((int)code, (int)down);
+		}
+		page[4]++;
+		page[5] = kind;
+		tail++;
+		__asm__ volatile("dmb sy" ::: "memory");
+		page[3] = tail;
+	}
+	page[6]++;
+	sender->setTimeoutMS(10);
+}
