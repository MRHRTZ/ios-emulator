+/* The physical phone retains its previous platform behavior. QEMU exposes
+ * PSCI through HVC; SYSTEM_OFF is reached only after BSD shutdown/unmount. */
+int
+SweetPlatformExpert::haltRestart(unsigned int type)
+{
+    DTEntry pc;
+    if (type == kPEHaltCPU && SecureDTLookupEntry(NULL, "/sweet-pc-input", &pc) == kSuccess) {
+        IOLog("SWEET PC: platform halt reached\n");
+        register uint64_t x0 __asm__("x0") = 0x84000008ULL; /* PSCI SYSTEM_OFF */
+        __asm__ volatile("hvc #0" : "+r"(x0) : :
+            "x1", "x2", "x3", "x4", "x5", "x6", "x7", "x8", "x9", "x10",
+            "x11", "x12", "x13", "x14", "x15", "x16", "x17", "cc", "memory");
+        IOLog("SWEET PC: PSCI SYSTEM_OFF returned %d\n", (int32_t)x0);
+        return -1;
+    }
+    return IODTPlatformExpert::haltRestart(type);
