+/* QEMU-only diagnostic block at input page +0x1000, outside the HID ring.
+ * Counters are independently sampled modulo 2^32; no image/control protocol.
+ * magic, vsyncs, submitted swaps, last callback us, total callback us,
+ * maximum callback us, flush divisor, version. Phone mappings stay untouched. */
+void
+AppleCLCD::recordVsyncCost(uint64_t started)
+{
+	if (fPCVideo) {
+		uint64_t ns = 0;
+		absolutetime_to_nanoseconds(mach_absolute_time() - started, &ns);
+		uint32_t us = (uint32_t)(ns / 1000);
+		fPCVideo[1027] = us;
+		fPCVideo[1028] += us;
+		if (us > fPCVideo[1029]) { fPCVideo[1029] = us; }
+	}
+}
