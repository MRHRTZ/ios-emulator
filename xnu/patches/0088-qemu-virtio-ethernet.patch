+/* Registry identity for configd. Packet I/O lives in sweet_virtnet.c, with
+ * no dependency on the closed IONetworkingFamily binary. These services are
+ * built-in and never unloaded, like the other SWEET IOKit stand-ins. */
+class IONetworkController : public IOService { OSDeclareDefaultStructors(IONetworkController); };
+class IOEthernetController : public IONetworkController { OSDeclareDefaultStructors(IOEthernetController); };
+class IONetworkInterface : public IOService { OSDeclareDefaultStructors(IONetworkInterface); };
+class IOEthernetInterface : public IONetworkInterface { OSDeclareDefaultStructors(IOEthernetInterface); };
+OSDefineMetaClassAndStructors(IONetworkController, IOService);
+OSDefineMetaClassAndStructors(IOEthernetController, IONetworkController);
+OSDefineMetaClassAndStructors(IONetworkInterface, IOService);
+OSDefineMetaClassAndStructors(IOEthernetInterface, IONetworkInterface);
+
+extern "C" void sweet_pc_network_publish(const uint8_t *mac)
+{
+    IOService *provider = IOService::getPlatform();
+    IOEthernetController *controller = new IOEthernetController;
+    if (!controller || !controller->init() || !controller->attach(provider) || !controller->start(provider)) {
+        IOLog("SWEET VNET: cannot publish Ethernet controller\n"); return;
+    }
+    controller->setName("QEMU Virtio Ethernet");
+    controller->setProperty("IOMACAddress", const_cast<uint8_t *>(mac), 6);
+    controller->setProperty("SelfNamed", kOSBooleanTrue);
+    controller->setProperty("IOBuiltin", kOSBooleanTrue);
+    controller->setProperty("IOModel", "Virtio Ethernet");
+    controller->setProperty("IOVendor", "QEMU");
+    controller->registerService();
+    IOEthernetInterface *interface = new IOEthernetInterface;
+    if (!interface || !interface->init() || !interface->attach(controller) || !interface->start(controller)) {
+        IOLog("SWEET VNET: cannot publish Ethernet interface\n"); return;
+    }
+    interface->setName("en0");
+    interface->setProperty("BSD Name", "en0");
+    interface->setProperty("IOInterfaceNamePrefix", "en");
+    interface->setProperty("IOInterfaceUnit", (unsigned long long)0, 32);
+    interface->setProperty("IOInterfaceType", (unsigned long long)6, 32);
+    interface->setProperty("IOInterfaceState", (unsigned long long)2, 32);
+    interface->setProperty("IOPrimaryInterface", kOSBooleanTrue);
+    interface->setProperty("IOBuiltin", kOSBooleanTrue);
+    interface->setProperty("IOMACAddress", const_cast<uint8_t *>(mac), 6);
+    interface->registerService();
+    IOLog("SWEET VNET: IOKit Ethernet identity en0 published\n");
+}
