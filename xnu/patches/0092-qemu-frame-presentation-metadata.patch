+
+/* Words 8..15 were reserved by protocol v1; the event ring starts at +64.
+ * Video magic appears only after the first real presentation. Until then the
+ * host keeps polling the boot console. Odd sequence means a copy is in flight.
+ * Neither this mapping nor its stores exists on the phone ADT path. */
+void
+AppleCLCD::beginFrame(void)
+{
+	if (fPCVideo) {
+		fPCVideo[9]++;
+		__asm__ volatile("dmb sy" ::: "memory");
+	}
+}
+
+void
+AppleCLCD::endFrame(uint64_t started)
+{
+	if (fPCVideo) {
+		uint64_t ns = 0;
+		absolutetime_to_nanoseconds(mach_absolute_time() - started, &ns);
+		fPCVideo[10]++;
+		fPCVideo[11] = (uint32_t)(ns / 1000);
+		fPCVideo[12] = fWidth;
+		fPCVideo[13] = fHeight;
+		fPCVideo[14] = fRowBytes;
+		__asm__ volatile("dmb sy" ::: "memory");
+		fPCVideo[9]++;
+		fPCVideo[8] = 0x56494431; /* VID1 */
+	}
 }
 
