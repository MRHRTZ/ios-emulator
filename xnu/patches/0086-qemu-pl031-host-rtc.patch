+#if defined(ARM64_BOARD_CONFIG_SWEET)
+extern "C" vm_offset_t ml_io_map(vm_offset_t, vm_size_t);
+/* QEMU virt PL031. The node is emitted only for the PC, never the phone. */
+static vm_offset_t sweet_pc_rtc(void)
+{
+	static vm_offset_t base;
+	if (!base) {
+		DTEntry entry;
+		const uintptr_t *reg = NULL;
+		unsigned int size = 0;
+		if (SecureDTLookupEntry(NULL, "/sweet-pc-rtc", &entry) != kSuccess ||
+		    SecureDTGetProperty(entry, "reg", (const void **)&reg, &size) != kSuccess ||
+		    size != 2 * sizeof(uintptr_t) || reg[0] != 0x09010000 || reg[1] != 0x1000) { return 0; }
+		base = ml_io_map(reg[0], reg[1]);
+	}
+	return base;
+}
+#endif
