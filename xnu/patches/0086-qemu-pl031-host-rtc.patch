 void
 PEGetUTCTimeOfDay(clock_sec_t * secs, clock_usec_t * usecs)
 {
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+	vm_offset_t rtc = sweet_pc_rtc();
+	if (rtc) {
+		*secs = *((volatile uint32_t *)rtc);
+		*usecs = 0;
+		return;
+	}
+#endif
 	clock_nsec_t    nsecs = 0;
 
